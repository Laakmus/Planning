# ============================================================
# Planning App — konfiguracja produkcyjna
# ============================================================
# Skopiuj ten plik jako .env i uzupełnij wartości.
# NIGDY nie commituj pliku .env z prawdziwymi kluczami!

# Supabase (self-hosted lub cloud)
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Public variables (widoczne w przeglądarce — ustaw na domenę/IP serwera)
PUBLIC_SUPABASE_URL=https://your-domain.com/supabase
PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# CORS — domena produkcyjna (BEZ trailing slash!)
CORS_ORIGIN=https://your-domain.com

# Node.js
HOST=0.0.0.0
PORT=4321

# Microsoft Graph OAuth2 — server-side (AUTH-MIG B3/B4, 2026-05-17)
# Frontendowe zmienne PUBLIC_MICROSOFT_* zostały usunięte — integracja
# OAuth2 Authorization Code + PKCE działa w pełni przez backend
# (endpointy `/api/v1/ms-oauth/*`).
# Rejestracja: Azure Portal → App registrations → Web, redirect URI:
#   https://your-domain.com/api/v1/ms-oauth/callback
# Wymagane uprawnienia: Microsoft Graph → Mail.Send, Mail.ReadWrite,
#                       offline_access, User.Read (delegated)
MICROSOFT_CLIENT_ID=<your-azure-app-client-id>
MICROSOFT_TENANT_ID=<your-azure-tenant-id-or-common>
MICROSOFT_CLIENT_SECRET=<your-azure-app-client-secret>
# Klucz pgcrypto do szyfrowania tokenów access/refresh w ms_oauth_tokens
APP_ENCRYPTION_KEY=<random-32-byte-base64-key>
